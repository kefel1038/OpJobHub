{
  "name": "@workspace/extension",
  "version": "0.1.0",
  "private": true,
  "description": "OpJobHub Recruitment Browser Extension — source, score, and save candidates from any page",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/chrome": "^0.0.280"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "manifest": {
    "name": "OpJobHub Recruiter",
    "description": "AI-powered recruitment assistant — source, score, and save candidates to OpJobHub",
    "permissions": [
      "storage",
      "activeTab",
      "scripting",
      "identity"
    ],
    "host_permissions": [
      "https://www.linkedin.com/*",
      "https://*.op-job-hub.vercel.app/*",
      "http://localhost:3000/*"
    ],
    "action": {
      "default_title": "OpJobHub Recruiter",
      "default_popup": "src/popup/index.html"
    },
    "icons": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
