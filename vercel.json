{
  "version": 2,
  "outputDirectory": "artifacts/placementbridge/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/$1",
      "continue": true
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
